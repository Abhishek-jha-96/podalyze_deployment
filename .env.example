# =============================================================================
# Podalyze deployment environment variables
# =============================================================================
# Usage:
#   1. Copy to .envs/.env.production  — loaded by all services in docker-compose.yml
#   2. Copy to .env (project root)      — used by deploy/backup scripts and compose
#                                       build-arg substitution (VITE_BASE_API_URL)
#
# Never commit real secrets. Replace all "change-me" placeholders before deploying.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Runtime mode for frontend entrypoint (production | development)
ENVIRONMENT=production

# Optional: pin git submodule versions (scripts/deploy.sh)
# FRONTEND_VERSION=
# BACKEND_VERSION=
# INFERENCE_VERSION=

# -----------------------------------------------------------------------------
# Frontend (docker-compose build arg + container env)
# -----------------------------------------------------------------------------
# Baked into the image at build time. Point at the nginx API proxy.
VITE_BASE_API_URL=http://localhost:8080/api

# -----------------------------------------------------------------------------
# Backend (NestJS — services/podalyze_backend)
# -----------------------------------------------------------------------------
# CORS origin — URL where the browser loads the frontend (via nginx or direct)
ALLOWED_ORIGINS=http://localhost:5173

# Internal Docker network URL; backend calls inference-server directly
INFERENCE_BASE_URL=http://inference-server:8000

# HMAC secret for session token hashing (auth.service.ts)
SECRET_KEY=change-me-hmac-secret

# JWT / auth token settings (ms format: 15m, 1h, 7d, etc.)
AUTH_JWT_SECRET=change-me-jwt-secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=change-me-refresh-secret
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_FORGOT_SECRET=change-me-forgot-secret
AUTH_FORGOT_TOKEN_EXPIRES_IN=1h
AUTH_CONFIRM_EMAIL_SECRET=change-me-confirm-email-secret
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

# -----------------------------------------------------------------------------
# MongoDB (mongo service — docker-compose.yml)
# -----------------------------------------------------------------------------
# Root credentials set on first container init (--auth enabled)
MONGO_INITDB_ROOT_USERNAME=podalyze
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=podalyze

# Backend connection (must match mongo root creds above)
# Leave DATABASE_URL empty to auto-build from the fields below:
# mongodb://<username>:<password>@<host>:<port>/<name>?authSource=admin
DATABASE_URL=
DATABASE_HOST=mongo
DATABASE_PORT=27017
DATABASE_USERNAME=podalyze
DATABASE_PASSWORD=change-me
DATABASE_NAME=podalyze
DATABASE_MAX_CONN=100
DATABASE_SSL=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_CERT=
DATABASE_KEY=

# -----------------------------------------------------------------------------
# Mongo Express (mongo-express service — internal admin UI)
# -----------------------------------------------------------------------------
ME_CONFIG_MONGODB_SERVER=mongo
ME_CONFIG_MONGODB_PORT=27017
ME_CONFIG_MONGODB_ADMINUSERNAME=podalyze
ME_CONFIG_MONGODB_ADMINPASSWORD=change-me
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Inference server (FastAPI — services/podalyze_inference)
# -----------------------------------------------------------------------------
# Celery worker broker (redis service on the compose network)
CELERY_BROKER_URL=redis://redis:6379/0
# Shared by inference cache and NestJS dashboard cache-manager.
# Use redis://localhost:6379 when running the backend on the host.
REDIS_CACHE_URL=redis://redis:6379
REDIS_CACHE_TTL_MS=300000

PROJECT_NAME=Podalyze Inference
DEVELOPER_KEY=your-youtube-data-api-v3-key
OAUTH_CRED=your-google-oauth-credentials
HF_TOKEN=your-huggingface-api-token
FRONTEND_HOST=http://localhost:8080
BACKEND_CORS_ORIGINS=http://localhost:8080

# Backend URL on the compose network (used by celery to PATCH task results)
BASE_API_SERVER_URL=http://backend:3000
# Shared secret for inference → backend task updates (header: X-Inference-Service-Key)
INFERENCE_SERVICE_SECRET=change-me-inference-service-secret
